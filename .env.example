# Cuotia savings circle contract with optional unanimous Writz Earn consent, deployed on Stellar Testnet.
NEXT_PUBLIC_CUOTIA_CONTRACT_ID=

# Stellar Asset Contract (SAC) de Circle USDC en Stellar Testnet.
# Es el token común para todos los círculos. Dirección pública, no es un secreto.
NEXT_PUBLIC_CUOTIA_TOKEN_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Opcional: permite conectar wallets móviles por WalletConnect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Cavos embedded Stellar wallet. Public App ID from the Cavos Dashboard (never an API secret).
NEXT_PUBLIC_CAVOS_APP_ID=
# Use development for Testnet/local work; switch to production only with the matching Cavos app.
NEXT_PUBLIC_CAVOS_ENVIRONMENT=development

# Opcional; por defecto se usa el RPC público de Stellar Testnet.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Opcional; el valor predeterminado es el relayer público de Writz Testnet.
WRITZ_RELAYER_URL=https://api.testnet.writz.xyz
